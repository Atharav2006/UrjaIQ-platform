# UrjaIQ Backend - Required Environment Variables
# Copy this file to .env for local development
# On Railway: set these in the Variables tab of your service

# PostgreSQL connection string (Railway auto-injects this when you add a Postgres plugin)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Groq AI API key (get from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API key (optional, fallback AI)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret key - use a long random string in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here_make_it_long_and_random
